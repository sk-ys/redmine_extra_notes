<% journal = local_assigns[:journal] %>
<% note_types = ExtraNotesHelper.enabled_note_types %>
<% if note_types.any? %>
  <span style="margin-top: 10px;">
    <label>
      <%= l(:label_extra_notes) %>:
      <%= select_tag 'extra_note_type',
            options_for_select(
              [['', '']] + note_types.map { |t| [t['label'].presence || "#{l(:label_extra_notes)} [#{t['id']}]", t['id']] },
              journal&.extra_attribute&.note_type
            ) %>
    </label>
  </span>
<% end %>
