<% if issue.project.module_enabled?(:extra_notes) %>
<% all_note_types = ExtraNotesHelper.note_types %>
<% tab_types = all_note_types.each_with_index
     .select { |t, _| t['enabled'].to_s != '0' && t['use_tab'].to_s != '0' }
     .map { |t, i| t.merge('order' => i + 1) } %>
<% if tab_types.any? %>

<script>
  window.extraNotes.init(
    <%= raw tab_types.map {
      |t| {
        id: t['id'],
        key: ExtraNotesHelper.effective_key(t),
        label: (t['tab_label'].presence || t['label'].presence || "#{l(:label_extra_notes)} ##{t['order']}")
      }
    }.to_json %>
  );
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
<% tab_types.each do |nt| %>
    (function() {
      var el = document.getElementById('tab-extra_notes_<%= j(ExtraNotesHelper.effective_key(nt)) %>');
      if (el) {
        el.textContent = '<%=
          j(nt['tab_label'].presence || nt['label'].presence || "#{l(:label_extra_notes)} ##{nt['order']}")
        %>';
      }
    })();
<% end %>
    window.extraNotes.refreshHistoryTab();
  });
</script>

<% end %>
<% end %>
