<% if issue.project.module_enabled?(:extra_notes) %>
<% all_note_types = ExtraNotesHelper.note_types %>
<% tab_types = all_note_types.each_with_index
     .select { |t, _| t['enabled'].to_s != '0' && t['use_tab'].to_s != '0' }
     .map { |t, i| t.merge('order' => i + 1) } %>
<% if tab_types.any? %>

<script>
(function() {
  var extraNoteTabTypes = <%= raw tab_types.map { |t| { id: t['id'] } }.to_json %>;

  // Override the default showIssueHistory function to handle extra note tabs
  var originalShowIssueHistory = window.showIssueHistory;
  window.showIssueHistory = function(journal, url) {
    var extraTab = extraNoteTabTypes.find(function(t) { return 'extra_notes_' + t.id === journal; });

    if (extraTab) {
      originalShowIssueHistory('notes', url);
      $('#tab-content-history').parent().find('.tabs a').removeClass('selected');
      $('#tab-extra_notes_' + extraTab.id).addClass('selected');
    } else {
      originalShowIssueHistory(journal, url);
    }

    switch(journal) {
      case 'notes':
        extraNoteTabTypes.forEach(function(t) {
          $('#tab-content-history').find('.journal:has(.extra-notes-label[data-note-type="' + t.id + '"])').hide();
        });
        break;
      default:
        if (extraTab) {
          $('#tab-content-history').find('.journal:not(:has(.extra-notes-label[data-note-type="' + extraTab.id + '"]))').hide();
        }
        break;
    }

    return false;
  };

  // Set custom tab labels from settings
  document.addEventListener('DOMContentLoaded', function() {
<% tab_types.each do |nt| %>
    (function() {
      var el = document.getElementById('tab-extra_notes_<%= j(nt['id']) %>');
      if (el) el.textContent = '<%= j(nt['tab_label'].presence || nt['label'].presence || "#{l(:label_extra_notes)} ##{nt['order']}") %>';
    })();
<% end %>
  });
})();
</script>

<% end %>
<% end %>
