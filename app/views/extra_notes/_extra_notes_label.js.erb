<% if journal.issue.project.module_enabled?(:extra_notes) %>

// Clear old extra notes labels for this journal
$("#change-<%= journal.id %> .extra-notes-label").remove();
<% if journal.extra_attribute.present? %>
  $("#change-<%= journal.id %> .journal-meta").prepend('<%= escape_javascript(render partial: "extra_notes/extra_notes_label", formats: [:html], locals: { journal: journal }) %>');
<% end %>

// Refresh history tab
window.extraNotes.refreshHistoryTab();

<% if journal.extra_attribute.present? %>
  $("#history .tabs #tab-extra_notes_<%= journal.extra_attribute.note_type %>").trigger("click");
<% else %>
  $("#history .tabs #tab-notes").trigger("click");
<% end %>

<% end %>
