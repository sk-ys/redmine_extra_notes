<% if journal.issue.project.module_enabled?(:extra_notes) %>
  <% journal.extra_attributes.each do |attr| %>
    <% note_type = ExtraNotesHelper.find_note_type(attr.note_type) %>
    <% next unless note_type && note_type['enabled'].to_s != '0' %>
    <span class="extra-notes-label"
          data-note-type="<%= attr.note_type %>"
          id="journal-<%= journal.id %>-extra_notes_marker_<%= attr.note_type %>">
      <%= note_type['label'].presence || '[EXTRA]' %>
    </span>
  <% end %>
<% end %>
